---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getVisiblePosts, sortPosts } from '../../lib/posts';

// 单个分类页：/categories/<分类名>
export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  const cats = new Set<string>();
  for (const post of posts) {
    const i = post.id.indexOf('/');
    if (i !== -1) cats.add(post.id.slice(0, i));
  }
  return [...cats].map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts.filter((p) => p.id.startsWith(category + '/')),
    },
  }));
}

const { category, posts } = Astro.props;
const sorted = sortPosts(posts);
const base = import.meta.env.BASE_URL;
---

<Base title={`分类：${category}`}>
  <p class="back-link"><a href={`${base}categories`}>← 返回分类总览</a></p>
  <h1>📁 分类：{category}</h1>
  <p class="post-excerpt">共 {sorted.length} 篇文章</p>

  <div class="post-list">
    {
      sorted.map((post) => (
        <PostCard post={post} />
      ))
    }
  </div>
</Base>
