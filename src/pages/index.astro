---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts, sortPosts } from '../lib/posts';
import { HERO_TITLE, HERO_SUBTITLE } from '../consts';
import linksConfig from '../links-config.json';

// 首页「最新文章」：置顶优先（全部展示），再按时间取最新 3 篇非置顶
const all = sortPosts(await getVisiblePosts());
const posts = [...all.filter((p) => p.data.pinned), ...all.filter((p) => !p.data.pinned).slice(0, 3)];
const links = linksConfig.links;
---

<Base title="首页">
  <section class="hero">
    <h1 aria-label={HERO_TITLE}>
      {
        // 逐字拆分（按 Unicode 码点，emoji 🍊 不会被拆坏），每字延迟 45ms 错峰入场
        Array.from(HERO_TITLE).map((ch, i) => (
          <span class="hero-char" aria-hidden="true" style={`animation-delay: ${80 + i * 45}ms`}>
            {ch === ' ' ? '\u00A0' : ch}
          </span>
        ))
      }
    </h1>
    <p>{HERO_SUBTITLE}</p>
  </section>

  <h2 class="section-title">🌐 网站收集</h2>
  <div class="card-grid">
    {
      links.map((link) => (
        <a class="cat-card link-card" href={link.url} target="_blank" rel="noopener">
          <div class="link-card-head">
            <span class="link-card-name">{link.name}</span>
            <span class="link-card-go" aria-hidden="true">↗</span>
          </div>
          <p class="link-card-desc">{link.description}</p>
          {
            link.note && <p class="link-card-note">💭 {link.note}</p>
          }
        </a>
      ))
    }
  </div>

  <h2 class="section-title">📝 最新文章</h2>
  <div class="post-list">
    {
      posts.map((post) => (
        <PostCard post={post} />
      ))
    }
  </div>

  {
    posts.length === 0 && (
      <p>还没有文章，去 <code>src/content/blog/</code> 里写第一篇吧。</p>
    )
  }
</Base>

<script>
  // 首页 hero 鼠标视差：仅桌面精确指针设备；lerp 平滑跟随，避免直连鼠标的生硬感
  (() => {
    const hero = document.querySelector('.hero');
    if (!hero) return;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || reduce) return;

    const title = hero.querySelector('h1');
    const sub = hero.querySelector('p');
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

    const onMove = (e: MouseEvent) => {
      const r = hero.getBoundingClientRect();
      cx = (e.clientX - r.left) / r.width - 0.5; // -0.5 ~ 0.5
      cy = (e.clientY - r.top) / r.height - 0.5;
    };

    const loop = () => {
      tx += (cx - tx) * 0.08;
      ty += (cy - ty) * 0.08;
      // 标题位移略大于副标题，形成轻微深度视差；幅度很小，克制
      if (title) title.style.transform = `translate3d(${(tx * -14).toFixed(2)}px, ${(ty * -10).toFixed(2)}px, 0)`;
      if (sub) sub.style.transform = `translate3d(${(tx * -7).toFixed(2)}px, ${(ty * -5).toFixed(2)}px, 0)`;
      raf = requestAnimationFrame(loop);
    };

    window.addEventListener('mousemove', onMove, { passive: true });
    raf = requestAnimationFrame(loop);
  })();
</script>
