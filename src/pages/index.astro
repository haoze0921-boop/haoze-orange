---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts, sortPosts } from '../lib/posts';
import { SITE_DESCRIPTION } from '../consts';

// 首页：置顶在前，其余按日期倒序；隐藏文章不显示
const posts = sortPosts(await getVisiblePosts());
---

<Base title="首页">
  <section class="hero">
    <h1>🍊 欢迎来到浩泽的橘子窝</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <h2 class="section-title">📝 最新文章</h2>
  <div class="post-list">
    {
      posts.map((post) => (
        <PostCard post={post} />
      ))
    }
  </div>

  {
    posts.length === 0 && (
      <p>还没有文章，去 <code>src/content/blog/</code> 里写第一篇吧。</p>
    )
  }
</Base>
