---
import Base from '../layouts/Base.astro';
import { ABOUT_BODY } from '../consts';

const base = import.meta.env.BASE_URL;
// 站点设置里可用 {%base%} 占位符，构建时替换为站点子路径（如 /haoze-orange/）
const aboutHtml = ABOUT_BODY.replace(/\{%base%\}/g, base);
---

<Base title="关于">
  <article class="prose">
    <Fragment set:html={aboutHtml} />
  </article>
</Base>
