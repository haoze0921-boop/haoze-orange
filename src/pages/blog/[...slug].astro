---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { formatDate } from '../../lib/format';
import { getVisiblePosts } from '../../lib/posts';

// 文章详情页：src/content/blog/ 下每个可见 .md 生成一个 /blog/<文件名> 页面（隐藏文章不生成）
export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
// 分类 = 文章所在目录
const cat = post.id.includes('/') ? post.id.slice(0, post.id.indexOf('/')) : '';
// View Transition 共享名：与首页/分类页的 PostCard 同名，点击卡片时「卡片展开成文章」
const vtName = 'vt-' + post.id.replace(/\//g, '-');
---

<Base title={post.data.title} description={post.data.description}>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <p class="back-link"><a href={`${base}`}>← 返回首页</a></p>

  <article class="prose" style={`view-transition-name: ${vtName}`}>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {
          post.data.updated && (
            <span>· 更新于 {formatDate(post.data.updated)}</span>
          )
        }
        {
          cat && (
            <a class="tag-pill" href={`${base}categories/${encodeURIComponent(cat)}`}>
              #{cat}
            </a>
          )
        }
        {
          post.data.tags.map((tag) => (
            <a class="tag-pill" href={`${base}search?tag=${encodeURIComponent(tag)}`}>
              #{tag}
            </a>
          ))
        }
      </div>
      {
        post.data.description && (
          <p class="post-excerpt">{post.data.description}</p>
        )
      }
    </header>

    <Content />
  </article>
</Base>

<script>
  // 阅读进度条：顶部细线随滚动增长（transform 驱动，性能好；reduced-motion 下也保留，
  // 因为它是功能反馈而非装饰动画）
  (() => {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    let ticking = false;
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      bar.style.transform = `scaleX(${p})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', update);
    // View Transitions 导航后滚动位置恢复，需要重算进度
    document.addEventListener('astro:after-swap', update);
    update();
  })();
</script>
