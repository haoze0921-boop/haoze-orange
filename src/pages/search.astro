---
import Base from '../layouts/Base.astro';
---

<Base title="搜索">
  <h1>🔍 搜索文章</h1>
  <p class="post-excerpt">按标题、简介、标签和正文内容搜索。想按分类或标签浏览？去<a href={`${import.meta.env.BASE_URL}categories`}>分类页</a>看看。</p>

  <input
    id="search-input"
    class="search-input"
    type="search"
    placeholder="输入关键词，如：博客 / Astro / 生活"
    autocomplete="off"
  />
  <p id="search-status" class="search-status">加载中…</p>
  <div id="search-results" class="post-list"></div>

  <script>
    const base = import.meta.env.BASE_URL;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const status = document.getElementById('search-status') as HTMLElement;
    const results = document.getElementById('search-results') as HTMLElement;

    let index: Array<{
      title: string;
      description: string;
      date: string;
      tags: string[];
      slug: string;
      body: string;
    }> = [];

    // 属性转义（标签文案）
    function esc(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    }

    // 从 Markdown 源码里去掉符号，保留可读正文片段（用于搜索匹配与摘要）
    function plainText(md: string): string {
      return md
        .replace(/<[^>]+>/g, ' ') // HTML 标签
        .replace(/```[\s\S]*?```/g, ' ') // 代码块
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // 图片
        .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // 链接只留文字
        .replace(/[#>*`\-_~|]/g, ' ')
        .replace(/\s+/g, ' ');
    }

    // 把命中的关键字包上 <mark> 高亮
    function highlight(text: string, keyword: string): string {
      if (!keyword) return text;
      const i = text.toLowerCase().indexOf(keyword.toLowerCase());
      if (i === -1) return text;
      return (
        text.slice(0, i) +
        '<mark>' +
        text.slice(i, i + keyword.length) +
        '</mark>' +
        text.slice(i + keyword.length)
      );
    }

    // 关键词搜索
    function render() {
      const keyword = input.value.trim().toLowerCase();
      const matches = index.filter((item) => {
        const text = [item.title, item.description, item.tags.join(' '), plainText(item.body)]
          .join(' ')
          .toLowerCase();
        return !keyword || text.includes(keyword);
      });

      if (!keyword) {
        status.textContent = '输入关键词，开始搜索文章';
        results.innerHTML = '';
        return;
      }

      status.textContent = matches.length ? `找到 ${matches.length} 篇相关文章` : `没有找到与「${keyword}」相关的文章 🍊`;

      if (matches.length === 0) {
        results.innerHTML = '<p class="post-excerpt">没有匹配的文章 🍊</p>';
        return;
      }

      results.innerHTML = matches
        .map((item) => {
          const desc = item.description || plainText(item.body).slice(0, 90);
          const vt = 'vt-' + item.slug.replace(/\//g, '-');
          return `
            <article class="post-card" style="view-transition-name: ${vt}">
              <a class="post-card-link" href="${base}blog/${item.slug}">
                <h2 class="post-card-title">${highlight(item.title, keyword)}</h2>
                ${desc ? `<p class="post-card-desc">${highlight(desc, keyword)}</p>` : ''}
              </a>
              <div class="post-card-meta">
                <time>${item.date}</time>
                ${(item.tags || [])
                  .map((t) => `<a class="tag-pill" href="${base}categories?tag=${encodeURIComponent(t)}">#${esc(t)}</a>`)
                  .join('')}
              </div>
            </article>
          `;
        })
        .join('');
    }

    input.addEventListener('input', render);

    fetch(`${base}search-index.json`)
      .then((r) => r.json())
      .then((data) => {
        index = data;
        render();
      })
      .catch(() => {
        status.textContent = '索引加载失败，请刷新页面重试 🍊';
      });
  </script>
</Base>
