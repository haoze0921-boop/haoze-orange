---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DesktopPet from '../components/DesktopPet.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  /** 页面标题，不填则用站点名 */
  title?: string;
  /** 页面描述，默认站点描述 */
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <DesktopPet />

    <script>
      // 文章图片滚动渐显（clip-path 揭幕效果），进入视口后永久显示
      const root = document.documentElement;
      root.classList.add('js-reveal');
      const imgs = document.querySelectorAll('.prose img');
      if (imgs.length) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          }, { rootMargin: '-80px 0px' });
          imgs.forEach((img) => io.observe(img));
        } else {
          imgs.forEach((img) => img.classList.add('revealed'));
        }
      }
    </script>
  </body>
</html>
