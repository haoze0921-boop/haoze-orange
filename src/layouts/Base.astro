---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DesktopPet from '../components/DesktopPet.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  /** 页面标题，不填则用站点名 */
  title?: string;
  /** 页面描述，默认站点描述 */
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <DesktopPet />

    <script>
      // 文章图片/章节标题滚动渐显（进入视口后永久显示），JS 禁用时不受影响
      const root = document.documentElement;
      root.classList.add('js-reveal');
      const revealTargets = document.querySelectorAll('.prose img, .prose h2, .prose h3');
      if (revealTargets.length) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          }, { rootMargin: '-80px 0px' });
          revealTargets.forEach((el) => io.observe(el));
        } else {
          revealTargets.forEach((el) => el.classList.add('revealed'));
        }
      }

      // 代码块复制按钮：点击复制代码，短暂显示「已复制」反馈
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制代码');
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code.trim());
          } catch {
            // 旧浏览器回退：临时 textarea 复制
            const ta = document.createElement('textarea');
            ta.value = code.trim();
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch { /* 忽略 */ }
            ta.remove();
          }
          btn.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = '复制';
            btn.classList.remove('copied');
          }, 1500);
        });
        pre.appendChild(btn);
      });

      // View Transitions 导航后：卡片 morph 已提供文章入场，禁用 .prose 自带动画防重播闪动
      // （直接访问/刷新时不会触发 after-swap，动画正常播放一次）
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll('.prose').forEach((el) => { el.style.animation = 'none'; });
      });
    </script>
  </body>
</html>
