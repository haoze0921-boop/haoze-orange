---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DesktopPet from '../components/DesktopPet.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  /** 页面标题，不填则用站点名 */
  title?: string;
  /** 页面描述，默认站点描述 */
  description?: string;
  /** 宽容器：首页/分类等列表页用（阅读页保持窄容器） */
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main class="main" id="main-content">
      <div class={wide ? 'container container-wide' : 'container'}>
        <slot />
      </div>
    </main>
    <Footer />
    <DesktopPet />

    <script>
      // 文章图片/章节标题滚动渐显（进入视口后永久显示），JS 禁用时不受影响
      const root = document.documentElement;
      root.classList.add('js-reveal');
      const revealTargets = document.querySelectorAll('.prose img, .prose h2, .prose h3');
      if (revealTargets.length) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          }, { rootMargin: '-80px 0px' });
          revealTargets.forEach((el) => io.observe(el));
        } else {
          revealTargets.forEach((el) => el.classList.add('revealed'));
        }
      }

      // 代码块复制按钮：点击复制代码，短暂显示「已复制」反馈
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制代码');
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code.trim());
          } catch {
            // 旧浏览器回退：临时 textarea 复制
            const ta = document.createElement('textarea');
            ta.value = code.trim();
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch { /* 忽略 */ }
            ta.remove();
          }
          btn.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = '复制';
            btn.classList.remove('copied');
          }, 1500);
        });
        pre.appendChild(btn);
      });

      // View Transitions 导航后：卡片 morph 已提供文章入场，禁用 .prose 自带动画防重播闪动
      // （直接访问/刷新时不会触发 after-swap，动画正常播放一次）
      // 注意：页面脚本每次导航后会在同一 document 上重跑，用标志避免监听器累积
      if (!window.__astroAfterSwapHooked) {
        window.__astroAfterSwapHooked = true;
        document.addEventListener('astro:after-swap', () => {
          document.querySelectorAll('.prose').forEach((el) => { el.style.animation = 'none'; });
        });
      }

      // 返回链接「智能返回」：若是站内导航进来的（history.state.index > 0），
      // 用 history.back() 触发 Astro 的 traverse，恢复上一页停留的滚动位置；
      // 直接打开页面（无站内历史）时退回默认 href 跳转。
      // 说明：普通 <a> 点击会被 ClientRouter 当作「前进」导航并滚到顶部，
      // 只有 history.back() 才会让 Astro 从 history.state 恢复滚动。
      document.querySelectorAll('.back-link a').forEach((link) => {
        link.addEventListener('click', (ev) => {
          const st = window.history.state;
          const canGoBack = st && typeof st.index === 'number' && st.index > 0;
          if (canGoBack) {
            ev.preventDefault();
            window.history.back();
          }
          // else: 无站内可退历史 → 走默认 href 跳转
        });
      });
    </script>
  </body>
</html>
