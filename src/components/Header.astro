---
import { SITE_TITLE, NAV_LINKS } from '../consts';

// 站点部署的子路径，如 '/' 或 '/orange-nest/'，所有链接用它拼
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;

// 「首页」固定在最前，其余导航项来自「站点设置」（后台可改）
function absolute(href: string): string {
  if (href.startsWith('/') || /^[a-z]+:\/\//i.test(href)) return href;
  return `${base}${href}`;
}

const links = [{ href: `${base}`, label: '首页' }].concat(
  NAV_LINKS.map((item) => ({ href: absolute(item.href), label: item.label }))
);

// 判断当前链接是否激活（首页精确匹配，其余前缀匹配）
function isActive(href: string): boolean {
  if (href === base) return current === base;
  return current.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href={`${base}`} aria-label="回到首页">
      🍊 {SITE_TITLE}
    </a>
    <nav class="site-nav">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
